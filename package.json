{
  "name": "dashcom",
  "version": "0.1.11",
  "description": "DashCom - plataforma de direccion comercial",
  "author": "DashCom",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "set NODE_OPTIONS=--use-system-ca&& tsx src/server/index.ts",
    "client": "vite --host 0.0.0.0",
    "server": "set NODE_OPTIONS=--use-system-ca&& tsx watch src/server/index.ts",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "start": "set NODE_OPTIONS=--use-system-ca&& tsx src/server/index.ts",
    "start:container": "tsx src/server/index.ts",
    "seed": "tsx src/server/seed.ts",
    "test": "vitest run",
    "db:reset": "tsx src/server/seed.ts --reset",
    "db:sync:from-docker": "powershell -ExecutionPolicy Bypass -File scripts/sync-db-from-docker.ps1",
    "desktop:rebuild-native": "electron-rebuild -f -w better-sqlite3 -v 41.10.3 -a x64",
    "desktop:build": "npm run build && npm run desktop:rebuild-native && electron-builder --win nsis --x64",
    "desktop:dir": "npm run build && npm run desktop:rebuild-native && electron-builder --win dir --x64",
    "desktop:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop-installer.ps1"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "pdfkit": "^0.19.1",
    "read-excel-file": "^9.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^41.10.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
